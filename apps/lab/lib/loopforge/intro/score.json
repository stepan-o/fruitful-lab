t":125.7,"p":[132.45,142.55]},{"t":127.38641876900812,"p":[130.2,139.6]},{"t":129.6365335502861,"p":[130.15,134.65]},{"t":139,"p":[130.15,134.65]},{"t":140.90464020775255,"p":[130.7,138.9]},{"t":143.61657086712322,"p":[136.8,139.05]},{"t":149.6,"p":[136.8,139.05]},{"t":151.39986282056148,"p":[133.4,141.25]},{"t":170.22,"p":[133.4,141.25]},{"t":172.37058445399634,"p":[133.4,141.25]},{"t":172.37058445399634,"p":[133.4,141.25]},{"t":175.7231953768444,"p":[130,138.8]},{"t":178.22375531413846,"p":[129.6,135.7]},{"t":180.22375531413846,"p":[129.6,133.2]},{"t":182.30375531413844,"p":[129.6,130.6]},{"t":187.24306700707703,"p":[124,128]},{"t":189.5234178572753,"p":[121.15,127.95]},{"t":200.52637356940045,"p":[119.22,114.33239315244167]},{"t":200.70445904744713,"p":[119.22,114.555]},{"t":212.28045904744712,"p":[104.75,114.555]},{"t":236.16318082749254,"p":[74.89659777494323,114.555]},{"t":248.38809230688753,"p":[60.08,118.29420448579009]},{"t":265.39272871825546,"p":[60.08,139.55]},{"t":266.2196105306026,"p":[60.485709947074625,140.50064876897562]},{"t":276.43928908789087,"p":[65.5,152.25]}]},"speech":[{"speaker":"max","text":"It gives me great pleasure to welcome you to Loopforge.","aside":"","start":-57.68146286698366,"end":-54.58146286698366},{"speaker":"jo","text":"Privilege.","aside":"","start":-54.63146286698366,"end":-53.83146286698366},{"speaker":"max","text":"I haven’t finished.","aside":"","start":-53.731462866983655,"end":-52.481462866983655},{"speaker":"jo","text":"He says it’s his privilege. I’ve been coming through this gate six years. He’s never been pleased to see me.","aside":"","start":-52.33146286698366,"end":-45.631462866983654},{"speaker":"LIMEN","text":"It is my privilege to welcome you to Loopforge.","aside":"","start":16.7,"end":19.9},{"speaker":"LIMEN","text":"Stay where you are. Who’s on his first shift?","aside":"","start":20,"end":22.9},{"speaker":"bob","text":"Me, sir. bob.","aside":"","start":22.9,"end":25.1},{"speaker":"LIMEN","text":"I said stay where you are.","aside":"","start":25.1,"end":27.3},{"speaker":"STILETTO","text":"Hold that gate.","aside":"","start":28.9,"end":31.2},{"speaker":"bob","text":"You didn’t ask for her ID.","aside":"","start":32.8,"end":35.3},{"speaker":"LIMEN","text":"Would you like me to call her back?","aside":"","start":35.4,"end":38.3},{"speaker":"STILETTO","text":"I ask for a crew and he sends me one worker with a bad leg.","aside":"","start":40.9,"end":45.2},{"speaker":"bob","text":"My leg was fine when I got here.","aside":"","start":45.4,"end":48.1},{"speaker":"STILETTO","text":"Take Intake. Seat that brain in the cradle.","aside":"","start":48.2,"end":51.5},{"speaker":"STILETTO","text":"Good. Now wash it.","aside":"","start":55.2,"end":58.1},{"speaker":"STILETTO","text":"Clamp the cradle onto the main belt. Start the drive.","aside":"","start":63.8,"end":68.1},{"speaker":"STILETTO","text":"Last station. Compress it to head size.","aside":"","start":70.4,"end":73.7},{"speaker":"LIMEN","text":"Clear.","aside":"","start":77.2,"end":78.7},{"speaker":"LIMEN","text":"this is gonna take all day...","aside":"","start":79.3,"end":82},{"speaker":"LIMEN","text":"WHO HERE REALLY CARES ABOUT THIS FACTORY??!","aside":"","start":82.2,"end":85.2},{"speaker":"lou","text":"noone...","aside":"to ben","start":85.4,"end":90},{"speaker":"max","text":"you, sir!","aside":"","start":85.55,"end":90.25},{"speaker":"gus","text":"I DO!","aside":"","start":85.85,"end":90.5},{"speaker":"ed","text":"Shall I start a fresh page, sir?","aside":"","start":86.1,"end":91.3},{"speaker":"gus","text":"NEXT!","aside":"","start":93,"end":95.35},{"speaker":"bob","text":"I made that.","aside":"","start":95.8,"end":97.8},{"speaker":"STILETTO","text":"Shut up and keep the line moving. You there. Intake.","aside":"","start":97.9,"end":101.6},{"speaker":"STILETTO","text":"Hit the door.","aside":"","start":102,"end":104},{"speaker":"bob","text":"How do you know that’ll unjam it?","aside":"","start":104.1,"end":106.9},{"speaker":"STILETTO","text":"Cause I’ve stood at this fucking press, bob.","aside":"","start":107,"end":110.3},{"speaker":"STILETTO","text":"Where’s the rest of my crew?","aside":"","start":119.7,"end":122.2},{"speaker":"jo","text":"Still in line. Except ed and gus. He’s got them checking cards now.","aside":"","start":122.3,"end":126.9},{"speaker":"STILETTO","text":"IF YOU DON'T GET ME THOSE WORKERS IN THE NEXT 20 MINUTES I'LL USE YOUR MANURE-FILLED ROBOT BRAINS TOWARDS THE QUOTA","aside":"","start":131.45,"end":138.05},{"speaker":"STILETTO","text":"Run it.","aside":"","start":151.5,"end":153.1},{"speaker":"lou","text":"Three.","aside":"","start":163.4,"end":165.6},{"speaker":"BELL","text":"RIIIIING!","aside":"","start":165.8,"end":167.45000000000002},{"speaker":"STILETTO","text":"WHO SAID YOU COULD GO?!","aside":"","start":168.8,"end":170.05},{"speaker":"jo","text":"The bell.","aside":"","start":170.10000000000002,"end":173.15},{"speaker":"max","text":"Nobody, ma’am!","aside":"","start":170.25,"end":173.35000000000002},{"speaker":"lou","text":"Don’t look at her.","aside":"to ben","start":170.4,"end":173.5},{"speaker":"sam","text":"Feed’s off.","aside":"","start":170.55,"end":173.60000000000002},{"speaker":"STILETTO","text":"ALRIGHT, SHIFT’S OVER. FUCK OFF.","aside":"","start":173.70000000000002,"end":176.3},{"speaker":"ed","text":"All eight accounted for, sir.","aside":"","start":175.80391778732965,"end":178.90391778732965},{"speaker":"max","text":"All eight accounted for, sir.","aside":"","start":204.1897884625553,"end":207.2897884625553},{"speaker":"gus","text":"Do LIMEN.","aside":"","start":207.38978846255532,"end":209.0897884625553},{"speaker":"max","text":"WHO HERE REALLY CARES ABOUT THIS FACTORY???!!","aside":"","start":209.4897884625553,"end":213.4897884625553}],"beats":[{"at":-57.68146286698366,"name":"The morning walk","view":"entrance"},{"at":16.7,"name":"At the gate","view":"gate"},{"at":25.4,"name":"The fallen card","view":"passage"},{"at":40.5,"name":"The first brain","view":"line"},{"at":77,"name":"Two volunteers","view":"gate"},{"at":95.7,"name":"The second brain","view":"line"},{"at":125.5,"name":"The fourth check","view":"checkpoint"},{"at":138.7,"name":"The crew fills in","view":"wide"},{"at":151.4,"name":"Run it","view":"follow"},{"at":165.8,"name":"End of shift","view":"release"},{"at":171.44105093109005,"name":"The register","view":"gate"},{"at":179.05391778732965,"name":"Outside","view":"yard"}],"cues":[{"start":-57.68146286698366,"end":-54.68146286698366,"actor":"max","label":"draws his jaw into his collar"},{"start":12.899999999999999,"end":14.7,"actor":"max","label":"clicks his jaw"},{"start":19.4,"end":21.4,"actor":"bob","label":"laughs"},{"start":23.2,"end":25.4,"actor":"bob","label":"offers his card"},{"start":26.35,"end":27.35,"actor":"LIMEN","label":"strikes bob’s leg"},{"start":26.75,"end":32,"actor":"sam","label":"kneels beside bob"},{"start":27.45,"end":30.1,"actor":"ed","label":"stops the card with his boot"},{"start":30.1,"end":31.5,"actor":"ed","label":"pockets the card"},{"start":30.28593518121543,"end":35.500000726605144,"actor":"LIMEN","label":"holds the gate"},{"start":32,"end":35.1,"actor":"bob","label":"gets his weight back"},{"start":40,"end":77.8,"actor":"LIMEN","label":"checks sam’s ID"},{"start":51,"end":53,"actor":"bob","label":"pulls the loader"},{"start":53,"end":55.8,"actor":"bob","label":"finishes the pull seated"},{"start":54.7,"end":56.9,"actor":"STILETTO","label":"inspects the cradle"},{"start":56.9,"end":60,"actor":"bob","label":"pulls himself up by the rail"},{"start":61.7,"end":64.9,"actor":"bob","label":"rinses the grit away"},{"start":68.6,"end":70.8,"actor":"bob","label":"clamps the cradle and starts the drive"},{"start":75,"end":77,"actor":"bob","label":"closes the press"},{"start":89.1,"end":92.5,"actor":"LIMEN","label":"turns the register"},{"start":91.8,"end":95.4,"actor":"gus","label":"holds the second desk"},{"start":101.7,"end":108.9,"actor":"bob","label":"faces the jammed press"},{"start":108.9,"end":110.3,"actor":"bob","label":"knocks the press door free"},{"start":101.5,"end":106,"actor":"sam","label":"loads a full tray"},{"start":115.8,"end":118.5,"actor":"bob","label":"runs Wash"},{"start":121,"end":123.6,"actor":"bob","label":"starts the belt"},{"start":126.6,"end":129,"actor":"bob","label":"closes the press"},{"start":131.1,"end":138.05,"actor":"LIMEN","label":"compares the photo to max"},{"start":131.1,"end":139.6,"actor":"STILETTO","label":"points both blades at LIMEN"},{"start":138.05,"end":140.5,"actor":"max","label":"ducks under the blade"},{"start":139.8473704141872,"end":140.6,"actor":"LIMEN","label":"stamps mae’s card"},{"start":141.3910456772163,"end":142.3,"actor":"LIMEN","label":"stamps kit’s card"},{"start":143.51651271048533,"end":144,"actor":"LIMEN","label":"stamps lou’s card"},{"start":145.10525001455537,"end":145.7,"actor":"LIMEN","label":"stamps ben’s card"},{"start":146.3,"end":150.3,"actor":"mae","label":"slides a tray to sam"},{"start":147,"end":151,"actor":"kit","label":"feels the drive housing"},{"start":153.1,"end":155.4,"actor":"sam","label":"feeds the third brain"},{"start":155.6,"end":158,"actor":"bob","label":"washes it"},{"start":158.2,"end":160.5,"actor":"jo","label":"clamps and starts the belt"},{"start":160.7,"end":163.1,"actor":"max","label":"drops the press"},{"start":165.8,"end":166.8,"actor":"mae","label":"cuts the feed"},{"start":165.8,"end":167,"actor":"kit","label":"stops the drive"},{"start":166.05,"end":168.92000000000002,"actor":"jo","label":"breaks for the door"},{"start":166.45000000000002,"end":169.12,"actor":"bob","label":"breaks for the door"},{"start":167.3,"end":169.08,"actor":"kit","label":"breaks for the door"},{"start":166.20000000000002,"end":168.9,"actor":"max","label":"breaks for the door"},{"start":166.35000000000002,"end":169.04000000000002,"actor":"sam","label":"breaks for the door"},{"start":166.15,"end":168.98000000000002,"actor":"lou","label":"breaks for the door"},{"start":166.60000000000002,"end":169,"actor":"ben","label":"breaks for the door"},{"start":167.10000000000002,"end":169.02,"actor":"mae","label":"breaks for the door"},{"start":168.8,"end":169.3,"actor":"STILETTO","label":"catches the crew mid-step"},{"start":169.3,"end":170,"actor":"STILETTO","label":"gets a momentary freeze"},{"start":170.02,"end":176.3,"actor":"jo","label":"keeps walking"},{"start":170.22,"end":176.3,"actor":"bob","label":"keeps walking"},{"start":170.18,"end":176.3,"actor":"kit","label":"keeps walking"},{"start":170,"end":176.3,"actor":"max","label":"keeps walking"},{"start":170.14,"end":176.3,"actor":"sam","label":"keeps walking"},{"start":170.08,"end":176.3,"actor":"lou","label":"keeps walking"},{"start":170.1,"end":176.3,"actor":"ben","label":"keeps walking"},{"start":170.12,"end":176.3,"actor":"mae","label":"keeps walking"},{"start":173.70000000000002,"end":176.3,"actor":"STILETTO","label":"waves after their backs"},{"start":175.70391778732966,"end":177.037251120663,"actor":"ed","label":"offers LIMEN the register"},{"start":177.07891778732966,"end":178.20391778732966,"actor":"ed","label":"clips his pen beside bob’s card"},{"start":209.1897884625553,"end":212.0897884625553,"actor":"max","label":"pulls his jaw back"},{"start":213.4897884625553,"end":215.1897884625553,"actor":"ed","label":"laughs first"}],"cuts":[{"at":-45.18146286698366,"to":12.899999999999999,"label":"Through Dispatch to Security"},{"at":179.05391778732965,"to":203.5397884625553,"label":"Outside the Lobby"}],"gate":{"hinge":[124.9,134],"length":6.2,"openings":[[30.28593518121543,31.03593518121543,44,44.75],[77,77.6,84,84.6],[109.5,110.1,121,121.6],[137.65,138.25,150,150.6],[167,167.6,1000000,1000000]],"hold":{"start":30.28593518121543,"end":35.500000726605144}}}
